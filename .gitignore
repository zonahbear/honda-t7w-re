# Never commit firmware, dumps, or bulky analysis output.
firmware/*
!firmware/README.md
analysis/*
!analysis/README.md
*.bin
*.img
*.mdt
*.zip
*.apk
*.jar
*.iso
extracted/
_*.extracted/

# Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
ghidra_projects/

# Secrets (should never exist here anyway)
.env
*.pem
*.key

# Gradle prototypes (build/ also holds staged third-party GPL sources: never commit)
prototypes/*/build/
prototypes/*/.gradle/
prototypes/*/.kotlin/
# Accessory identities (DiPlay offline-mfi etc.): never commit, repo is public
runtime-assets/
offline-mfi/
*.pk8
*.p7b
t7w-keys/
